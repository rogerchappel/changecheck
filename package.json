{
  "name": "changecheck",
  "version": "0.1.0",
  "description": "Local-first release consistency checker for changelogs, package versions, git tags, and release notes.",
  "type": "module",
  "main": "./dist/checker.js",
  "bin": {
    "changecheck": "./dist/cli.js"
  },
  "files": [
    "dist",
    "demo",
    "docs",
    "examples",
    "fixtures",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "npm run test:suite-contract && node scripts/test-suite.mjs",
    "test:suite-contract": "node --test scripts/test-suite.test.mjs",
    "smoke": "node dist/cli.js check fixtures/sample-release --format text",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "release:contract": "node scripts/release-contract.mjs",
    "test:release-contract": "node --test scripts/release-contract.test.mjs",
    "package:contract": "node scripts/package-contract.mjs",
    "test:package-contract": "node --test scripts/package-contract.test.mjs",
    "release:check": "npm run release:contract && npm run test:release-contract && npm run package:contract && npm run test:package-contract && npm run check && npm run lint && npm run build && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "changelog",
    "release",
    "version",
    "consistency",
    "cli",
    "audit",
    "local-first"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/changecheck.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.19",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "globals": "^16.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/changecheck.git"
  },
  "homepage": "https://github.com/rogerchappel/changecheck#readme",
  "bugs": {
    "url": "https://github.com/rogerchappel/changecheck/issues"
  },
  "exports": "./dist/checker.js"
}
